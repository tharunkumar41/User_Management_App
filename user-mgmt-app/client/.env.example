# Copy to client/.env  (Vite only reads .env files from the client/ root, not from src/)

# Google reCAPTCHA v2 site key. This is Google's public TEST key (always passes); use your real key in production.
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Google OAuth Client ID (same value as GOOGLE_CLIENT_ID in server/.env)
VITE_GOOGLE_CLIENT_ID=798905441357-k4lrlqp3ihd0svc4hekjaj94al8l8sku.apps.googleusercontent.com

# ---- Firebase Cloud Messaging (web push). Optional: leave empty to hide the "Enable notifications" button ----
# Firebase console > Project settings > General > Your apps > Web app > SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Project settings > Cloud Messaging > Web configuration > Web Push certificates > Generate key pair
VITE_FIREBASE_VAPID_KEY=
