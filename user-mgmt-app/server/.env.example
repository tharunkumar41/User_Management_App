# ---- Required ----
# Matches docker-compose.yml. Change it if you use your own PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/user_mgmt?schema=public"
# Any long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_EXPIRES_IN=7d

# ---- Email (Gmail SMTP with an App Password) ----
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Captcha / Google sign-in ----
# This is Google's public TEST secret (always passes). Use your real secret in production.
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
GOOGLE_CLIENT_ID=

# ---- Realtime chat ----
REDIS_URL=redis://localhost:6379

# ---- Push notifications (Firebase Admin SDK) ----
# Firebase console > Project settings > Service accounts > Generate new private key.
# Optional: leave empty to run without push notifications.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences exactly as they appear in the downloaded JSON.
FIREBASE_PRIVATE_KEY=
